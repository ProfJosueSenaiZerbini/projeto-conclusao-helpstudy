# =====================================================================
# Modelo do arquivo .env
# Copie este arquivo, renomeie a cópia para ".env" e preencha os valores.
# O arquivo .env NÃO deve ir para o GitHub (já está no .gitignore).
# =====================================================================

# Configurações do banco de dados MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=sua_senha_do_mysql
DB_NAME=helpstudy

# Configurações do servidor
PORT=3000

# Chave secreta usada para assinar os tokens JWT (use uma string aleatória e longa)
# Para gerar uma: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque_por_uma_chave_aleatoria_e_longa
JWT_EXPIRES_IN=7d

# E-mail usado para mandar o código de "Esqueci a senha" (Gmail)
# EMAIL_PASS é uma "senha de app" do Gmail (não é a senha normal da conta).
# Se deixar em branco, o código aparece no terminal (bom para testes).
EMAIL_USER=seu_email@gmail.com
EMAIL_PASS=sua_senha_de_app
